# ARGOS — modelo de variáveis de ambiente
# Copie para .env e preencha os valores necessários.
# Nunca publique .env nem coloque credenciais reais neste arquivo.

# Obrigatória para iniciar o Flask. Gere com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Use 0 somente em desenvolvimento local com http://localhost.
# Em produção HTTPS, mantenha 1 (ou omita, pois o padrão do app é 1).
COOKIE_SECURE=0

# Necessária para habilitar as respostas do chatbot.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_URL=https://api.groq.com/openai/v1/chat/completions

# Limite de mensagens do chatbot por IP a cada 10 minutos (padrão: 20).
CHAT_LIMITE=20

# Banco de dados. Deixe vazio para usar o SQLite local (argos.db).
# Para guardar os dados na publicação, use um PostgreSQL externo (ex.: Neon):
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# O envio de avisos de pedido é opcional.
RESEND_API_KEY=
NOTIFY_EMAIL=
MAIL_FROM=ARGOS <onboarding@resend.dev>
